<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Thermal — PC health" Width="1220" Height="960" MinWidth="960" MinHeight="680" Background="#101317" Foreground="#EAF0F5" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#8B99A7"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EAF0F5"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#8B99A7"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#CFDAE4"/><Setter Property="Background" Value="#202830"/><Setter Property="Padding" Value="15,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#34434E"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#181E24"/><Setter Property="BorderBrush" Value="#2A333D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="22"/></Style>
  <Style TargetType="ProgressBar"><Setter Property="Height" Value="5"/><Setter Property="Background" Value="#29313B"/><Setter Property="Foreground" Value="#5BDAB0"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="#101317"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#35434F" CornerRadius="4" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DBE3EA"/><Setter Property="Margin" Value="0,10"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#EAF0F5"/><Setter Property="Background" Value="#101317"/><Setter Property="BorderBrush" Value="#3C4D5B"/><Setter Property="Padding" Value="10"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="192"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#14191F" BorderBrush="#29313A" BorderThickness="0,0,1,0">
   <Grid Margin="20,30,18,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="◈" Foreground="#64E3B7" FontSize="29" Margin="0,0,10,0"/><TextBlock Text="thermal" FontSize="26" FontWeight="SemiBold"/></StackPanel><TextBlock Text="YOUR PC, AT A GLANCE" FontSize="9" Foreground="#7C8B9A" Margin="1,8,0,42"/>
     <Button x:Name="DashboardNav" Content="◫    Overview" HorizontalContentAlignment="Left" Background="#233A34" Margin="0,0,0,10"/>
     <Button x:Name="SensorsNav" Content="≋    All sensors" Background="Transparent" Margin="0,0,0,10"/>
     <Button x:Name="SettingsNav" Content="⚙    Settings" Background="Transparent"/>
    </StackPanel>
    <StackPanel Grid.Row="2"><Border Background="#1B2727" CornerRadius="8" Padding="13"><StackPanel><TextBlock Text="LOCAL BY DESIGN" FontSize="10" Foreground="#64D9B1" FontWeight="SemiBold"/><TextBlock Text="7 days of history.&#10;Only on this PC." Foreground="#A4B5BC" FontSize="12" LineHeight="20" Margin="0,8,0,0"/></StackPanel></Border><TextBlock Text="THERMAL  /  1.0" Foreground="#5E6E7E" FontSize="10" Margin="4,22,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="30,26,30,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,24"><StackPanel><TextBlock x:Name="PageTitle" Text="System overview" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="MachineText" Text="Connecting to your hardware…" Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Border Background="#1D302C" CornerRadius="20" Padding="12,7" Margin="0,0,12,0"><TextBlock x:Name="LiveBadge" Text="●  CONNECTING" Foreground="#66E1B7" FontSize="10" FontWeight="SemiBold"/></Border><Button x:Name="CompactButton" Content="▣   Mini monitor"/></StackPanel></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
     <StackPanel x:Name="DashboardPage">
      <Border x:Name="NoticeBox" Background="#29261E" BorderBrush="#544832" BorderThickness="1" CornerRadius="7" Padding="14,10" Margin="0,0,0,18"><TextBlock x:Name="NoticeText" Text="Discovering available sensors. The first reading may take a few seconds." Foreground="#DCC89C" TextWrapping="Wrap"/></Border>
      <UniformGrid Columns="4" Margin="0,0,-12,20">
       <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="CPU TEMPERATURE" Style="{StaticResource Caption}" FontSize="10"/><TextBlock x:Name="CpuValue" Text="—" Foreground="#66E1B7" FontSize="38" FontWeight="SemiBold" Margin="0,12,0,10"/><ProgressBar x:Name="CpuBar" Maximum="110"/><TextBlock x:Name="CpuDetail" Text="Waiting for sensor" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="GPU TEMPERATURE" Style="{StaticResource Caption}" FontSize="10"/><TextBlock x:Name="GpuValue" Text="—" Foreground="#ABAEFF" FontSize="38" FontWeight="SemiBold" Margin="0,12,0,10"/><ProgressBar x:Name="GpuBar" Maximum="110" Foreground="#A5A8FA"/><TextBlock x:Name="GpuDetail" Text="Waiting for sensor" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="CPU UTILIZATION" Style="{StaticResource Caption}" FontSize="10"/><TextBlock x:Name="LoadValue" Text="—" FontSize="38" FontWeight="SemiBold" Margin="0,12,0,10"/><ProgressBar x:Name="LoadBar" Foreground="#72B9ED"/><TextBlock x:Name="LoadDetail" Text="Live processor load" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="MEMORY IN USE" Style="{StaticResource Caption}" FontSize="10"/><TextBlock x:Name="MemoryValue" Text="—" FontSize="38" FontWeight="SemiBold" Margin="0,12,0,10"/><ProgressBar x:Name="MemoryBar" Foreground="#D2B67C"/><TextBlock x:Name="MemoryDetail" Text="Physical memory" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
      </UniformGrid>
      <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel>
       <Grid><StackPanel><TextBlock Text="Temperature history" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Minute averages · peaks preserved · gaps mean no data" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button x:Name="Range1" Content="1h" Padding="12,7" Margin="0,0,5,0" Background="#2C4840"/><Button x:Name="Range6" Content="6h" Padding="12,7" Margin="0,0,5,0"/><Button x:Name="Range24" Content="24h" Padding="12,7" Margin="0,0,5,0"/><Button x:Name="Range168" Content="7d" Padding="12,7"/></StackPanel></Grid>
       <StackPanel Orientation="Horizontal" Margin="0,18,0,6"><TextBlock Text="●  CPU" Foreground="#66E1B7" FontSize="12" Margin="0,0,22,0"/><TextBlock Text="●  GPU" Foreground="#ABAEFF" FontSize="12"/><TextBlock x:Name="ChartUnit" Text="°C" Style="{StaticResource Caption}" Margin="22,0,0,0"/></StackPanel>
       <Grid x:Name="ChartHost" Height="190" ClipToBounds="True"/>
       <Border BorderBrush="#2A333D" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,16,0,0"><Grid><TextBlock x:Name="HistoryStats" Text="Your history will appear as readings arrive." Style="{StaticResource Caption}"/><Button x:Name="ExportButton" Content="Export CSV ↗" HorizontalAlignment="Right" Padding="10,5" Background="Transparent" Margin="0,-5,0,-5"/></Grid></Border>
      </StackPanel></Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Hardware" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="PROCESSOR" Style="{StaticResource Caption}" FontSize="10" Margin="0,16,0,5"/><TextBlock x:Name="CpuName" Text="Discovering…" TextWrapping="Wrap"/><TextBlock Text="GRAPHICS" Style="{StaticResource Caption}" FontSize="10" Margin="0,14,0,5"/><TextBlock x:Name="GpuName" Text="Discovering…" TextWrapping="Wrap"/></StackPanel></Border>
       <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0"><StackPanel><TextBlock Text="System essentials" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="Essentials" Text="Power  —     Fan  —     Drive  —" Margin="0,16,0,16" TextWrapping="Wrap"/><ProgressBar x:Name="DiskBar" Foreground="#779DB8"/><TextBlock x:Name="DiskText" Text="Reading system drive…" Style="{StaticResource Caption}" Margin="0,10,0,0"/><TextBlock x:Name="UptimeText" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
      </Grid>
     </StackPanel>
     <StackPanel x:Name="SensorsPage" Visibility="Collapsed"><TextBlock Text="Every available reading from your hardware, refreshed every two seconds." Foreground="#93A5B4" Margin="0,0,0,20"/><ItemsControl x:Name="SensorList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#181E24" CornerRadius="6" Padding="16,12" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Kind}" Foreground="#8798A8" FontSize="10" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Hardware}" Foreground="#8798A8" TextWrapping="Wrap" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Display}" Foreground="#6BE2BB" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Make yourself comfortable" FontSize="19" FontWeight="SemiBold"/><CheckBox x:Name="StartupCheck" Content="Launch Thermal when I sign in to Windows" Margin="0,22,0,10"/><CheckBox x:Name="CompactCheck" Content="Start in mini monitor mode"/><TextBlock Text="Mini monitor corner · on the display containing the dashboard" Style="{StaticResource Caption}" Margin="0,16,0,8"/><ComboBox x:Name="CornerSelect" Width="190" HorizontalAlignment="Left" Padding="8" SelectedIndex="0"><ComboBoxItem Content="Bottom right"/><ComboBoxItem Content="Bottom left"/><ComboBoxItem Content="Top right"/><ComboBoxItem Content="Top left"/></ComboBox><TextBlock Text="Drag the mini monitor by its header. Double-click its header to open the dashboard." Style="{StaticResource Caption}" Margin="0,15,0,0" TextWrapping="Wrap"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Temperature notices" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Visual warnings in both views. These are your thresholds, not hardware safety limits." Style="{StaticResource Caption}" Margin="0,10,0,16" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal"><TextBlock Text="CPU °C" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox x:Name="CpuThreshold" Text="85" Width="70"/><TextBlock Text="GPU °C" VerticalAlignment="Center" Margin="30,0,12,0"/><TextBox x:Name="GpuThreshold" Text="85" Width="70"/></StackPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Private, rolling history" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="One-minute averages and temperature peaks are saved locally. Readings older than seven days are removed while Thermal runs and at next launch. Recording continues in the tray; it stops when you quit or the PC sleeps." Foreground="#93A5B4" TextWrapping="Wrap" Margin="0,12,0,14" LineHeight="21"/><TextBlock x:Name="DataPath" Foreground="#6BE2BB" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button x:Name="OpenFolder" Content="Open data folder" Margin="0,0,12,0"/><Button x:Name="AdminButton" Content="Restart as administrator"/></StackPanel><TextBlock Text="Administrator access may unlock CPU and board temperatures. Some hardware does not expose every sensor. Windows security settings are never changed." Style="{StaticResource Caption}" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Temperature sensor setup" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="CPU and motherboard readings use the signed PawnIO driver. Install it once, then restart Thermal as administrator. Windows will ask for permission to install the driver." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,16"/><Button x:Name="DriverButton" Content="Set up temperature sensors" HorizontalAlignment="Left"/></StackPanel></Border>
      <StackPanel><Button x:Name="SaveSettings" Content="Save preferences" Background="#285342" Foreground="#8EF4CF" HorizontalAlignment="Left"/><TextBlock x:Name="SettingsResult" Margin="0,12,0,0" Foreground="#83E4C1" TextWrapping="Wrap"/></StackPanel>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <Grid Grid.Row="2" Margin="0,18,0,0"><TextBlock x:Name="StatusText" Text="Initializing sensors…" FontSize="11" Foreground="#7A8C9B"/><TextBlock Text="Close to tray  ·  Right-click tray icon to quit" FontSize="11" Foreground="#627584" HorizontalAlignment="Right"/></Grid>
  </Grid>
 </Grid>
</Window>

